{
  "info": {
    "_postman_id": "6bf88998-b3b5-520f-b4a3-9070dab2c2be",
    "name": "Supabase Auth - Testes Caixa Cinza",
    "description": "Testes de caixa cinza do endpoint de login por senha do Supabase Auth (POST /auth/v1/token?grant_type=password).\n\nSelecione o environment **Supabase Auth - Testes** e preencha base_url, api_key, email e password antes de executar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Requisição base",
      "description": "Requisição obrigatória da Etapa 3, usando as variáveis do environment.",
      "item": [
        {
          "name": "Login - POST /auth/v1/token (grant_type=password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ---- auxiliares ----",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) { json = null; }",
                  "const mensagemErro = (b) => b ? (b.msg || b.error_description || b.message || b.error || '') : '';",
                  "",
                  "pm.test('Requisição respondida pela API de autenticação', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 422, 429]);",
                  "});",
                  "",
                  "pm.test('Resposta está em formato JSON', function () {",
                  "    pm.expect(json, 'corpo não é JSON').to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{api_key}}",
                "type": "text",
                "description": "Chave pública (anon/publishable) do projeto Supabase"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}",
                "type": "text",
                "description": "Mesmo valor da apikey, no formato Bearer"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/v1/token?grant_type=password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "description": "Autentica o usuário por e-mail e senha e retorna um access_token (JWT)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 - Cenários obrigatórios",
      "item": [
        {
          "name": "CT01 - Login válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ---- auxiliares ----",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) { json = null; }",
                  "const mensagemErro = (b) => b ? (b.msg || b.error_description || b.message || b.error || '') : '';",
                  "",
                  "pm.test('Status HTTP 200 (OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Resposta está em formato JSON', function () {",
                  "    pm.expect(json, 'corpo não é JSON').to.be.an('object');",
                  "});",
                  "",
                  "pm.test('access_token retornado (JWT com 3 partes)', function () {",
                  "    pm.expect(json.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.access_token.split('.')).to.have.lengthOf(3);",
                  "});",
                  "",
                  "pm.test('token_type é bearer', function () {",
                  "    pm.expect(String(json.token_type).toLowerCase()).to.eql('bearer');",
                  "});",
                  "",
                  "pm.test('expires_in maior que zero e refresh_token presente', function () {",
                  "    pm.expect(json.expires_in).to.be.a('number').and.above(0);",
                  "    pm.expect(json.refresh_token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('Usuário retornado corresponde ao e-mail do environment', function () {",
                  "    pm.expect(json.user).to.be.an('object');",
                  "    pm.expect(String(json.user.email).toLowerCase())",
                  "        .to.eql(String(pm.environment.get('email')).toLowerCase());",
                  "});",
                  "",
                  "pm.test('Payload do JWT contém role authenticated', function () {",
                  "    const payload = JSON.parse(atob(json.access_token.split('.')[1]",
                  "        .replace(/-/g, '+').replace(/_/g, '/')));",
                  "    pm.expect(payload.role).to.eql('authenticated');",
                  "    console.log('Payload do access_token:', payload);",
                  "});",
                  "",
                  "pm.test('Tempo de resposta abaixo de 3000 ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{api_key}}",
                "type": "text",
                "description": "Chave pública (anon/publishable) do projeto Supabase"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}",
                "type": "text",
                "description": "Mesmo valor da apikey, no formato Bearer"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/v1/token?grant_type=password",
