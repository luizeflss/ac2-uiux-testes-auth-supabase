          "name": "CT02 - Senha incorreta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ---- auxiliares ----",
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) { json = null; }",
                  "const mensagemErro = (b) => b ? (b.msg || b.error_description || b.message || b.error || '') : '';",
                  "",
                  "pm.test('Status HTTP 400 (Bad Request)', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Resposta está em formato JSON', function () {",
                  "    pm.expect(json, 'corpo não é JSON').to.be.an('object');",
                  "});",
                  "",
                  "pm.test('Não retorna access_token (acesso negado)', function () {",
                  "    pm.expect(json).to.not.have.property('access_token');",
                  "});",
                  "",
                  "pm.test('Retorna mensagem de erro', function () {",
                  "    const msg = mensagemErro(json);",
                  "    pm.expect(msg, 'mensagem de erro vazia').to.be.a('string').and.not.empty;",
                  "    console.log('Mensagem de erro retornada:', msg);",
                  "});",
                  "",
                  "pm.test('Mensagem: Invalid login credentials', function () {",
                  "    pm.expect(mensagemErro(json)).to.include('Invalid login credentials');",
                  "});",
                  "",
                  "pm.test('Código de erro invalid_credentials (quando informado)', function () {",
                  "    if (json.error_code) { pm.expect(json.error_code).to.eql('invalid_credentials'); }",
                  "    else if (json.error) { pm.expect(json.error).to.eql('invalid_grant'); }",
                  "});",
                  "",
                  "// Guarda a mensagem para comparar com o cenário de usuário inexistente (CT03).",
                  "pm.collectionVariables.set('msg_senha_incorreta', mensagemErro(json));"
                ]
              }
